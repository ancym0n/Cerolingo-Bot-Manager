{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cerolingo Bot Manager",
  "mainBinaryName": "cerolingo-bot-manager",
  "identifier": "com.ancymon.cerolingo-bot-manager",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "CerolingoBM",
        "url": "views/index.html",
        "width": 820,
        "height": 620,
        "minWidth": 360,
        "minHeight": 480,
        "center": true,
        "backgroundColor": "#131f24"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage"],
    "category": "Utility",
    "shortDescription": "Cerolingo Bot Manager",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "../build/logo.ico",
        "headerImage": "../build/installer/header.bmp",
        "sidebarImage": "../build/installer/sidebar.bmp",
        "installMode": "currentUser"
      }
    }
  }
}
